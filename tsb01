local function createSlider(parent, key, minV, maxV, currentVal, callback, suffix)
    local row = Instance.new("Frame", parent)
    row.Size = UDim2.new(1, 0, 0, 48)
    row.BackgroundColor3 = Color3.fromRGB(16, 20, 30)
    row.BackgroundTransparency = 0.15
    Instance.new("UICorner", row).CornerRadius = UDim.new(0, 10)
    local rStroke = Instance.new("UIStroke", row)
    rStroke.Color = Settings.C1
    rStroke.Thickness = 1
    rStroke.Transparency = 0.9
    local sfx = suffix or ""
    local lbl = Instance.new("TextLabel", row)
    lbl.Size = UDim2.new(1, -20, 0, 18)
    lbl.Position = UDim2.new(0, 12, 0, 5)
    lbl.BackgroundTransparency = 1
    lbl.TextColor3 = Color3.fromRGB(210, 220, 235)
    lbl.Font = Enum.Font.GothamBold
    lbl.TextSize = 11
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Text = L(key) .. ": " .. (math.floor(currentVal * 10) / 10) .. sfx
    local track = Instance.new("TextButton", row)
    track.Size = UDim2.new(1, -24, 0, 14)
    track.Position = UDim2.new(0, 12, 0, 26)
    track.BackgroundColor3 = Color3.fromRGB(26, 32, 44)
    track.Text = ""
    track.AutoButtonColor = false
    Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)
    local fill = Instance.new("Frame", track)
    fill.Size = UDim2.new((currentVal - minV) / (maxV - minV), 0, 1, 0)
    fill.BackgroundColor3 = Settings.C1
    Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)
    local fillGrad = Instance.new("UIGradient", fill)
    fillGrad.Color = ColorSequence.new(Settings.C1, Settings.C2)
    local handle = Instance.new("Frame", fill)
    handle.Size = UDim2.new(0, 18, 0, 18)
    handle.Position = UDim2.new(1, -9, 0.5, -9)
    handle.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    handle.ZIndex = 5
    Instance.new("UICorner", handle).CornerRadius = UDim.new(1, 0)
    local handleStroke = Instance.new("UIStroke", handle)
    handleStroke.Color = Settings.C1
    handleStroke.Thickness = 2
    local handleGlow = Instance.new("UIStroke", handle)
    handleGlow.Color = Settings.C1
    handleGlow.Thickness = 6
    handleGlow.Transparency = 0.7
    local function setV(v)
        v = math.clamp(v, minV, maxV)
        currentVal = v
        local ratio = (v - minV) / (maxV - minV)
        lbl.Text = L(key) .. ": " .. (math.floor(v * 10) / 10) .. sfx
        fill.Size = UDim2.new(ratio, 0, 1, 0)
        if callback then callback(v) end
    end
    local draggingSlider = false
    local function updateFromInput(input)
        local absPos, absSize = track.AbsolutePosition, track.AbsoluteSize
        if absSize.X <= 0 then return end
        local x = input.Position.X - absPos.X
        setV(minV + (maxV - minV) * math.clamp(x / absSize.X, 0, 1))
    end
    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            draggingSlider = true
            updateFromInput(input)
            local conn
            conn = input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    draggingSlider = false
                    if conn then conn:Disconnect() end
                end
            end)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if not draggingSlider then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            updateFromInput(input)
        end
    end)
    table.insert(IconRecolors, function(color)
        if fill and fill.Parent then fill.BackgroundColor3 = color end
        if handleStroke and handleStroke.Parent then handleStroke.Color = color end
        if handleGlow and handleGlow.Parent then handleGlow.Color = color end
    end)
    table.insert(LangRefs.sliders, {lbl=lbl, key=key, suffix=sfx, getVal=function() return currentVal end})
    return {setV=setV}
end

