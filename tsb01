local function perfAIDisable()
    if not PerfAI.active then return end
    PerfAI.active = false
    if PerfAI.savedQuality then
        pcall(function() settings().Rendering.QualityLevel = PerfAI.savedQuality end)
    end
    if G.PerfBoost then applyPerfBoost() end
    pcall(function() setfpscap(Settings.FpsCap or 240) end)
end

local function perfAIUpdate(dt)
    if Zarzura.suspended then return end
    PerfAI.lastCheck = PerfAI.lastCheck + dt
    if PerfAI.lastCheck < PerfAI.checkInterval then return end
    PerfAI.lastCheck = 0
    table.insert(PerfAI.fpsHistory, fps)
    if #PerfAI.fpsHistory > 5 then table.remove(PerfAI.fpsHistory, 1) end
    local sum = 0
    for _, v in ipairs(PerfAI.fpsHistory) do sum = sum + v end
    local avg = sum / math.max(1, #PerfAI.fpsHistory)
    if avg <= 15 and avg > 0 then perfAIEnable()
    elseif avg > 20 then perfAIDisable() end
end

