local function isEnemy(p)
    if p == LocalPlayer then return false end
    if not G.TeamCheck then return true end
    local myTeam = LocalPlayer.Team
    if myTeam and p.Team then return p.Team ~= myTeam end
    return true
end

local wallParams = RaycastParams.new()
wallParams.FilterType = Enum.RaycastFilterType.Exclude
wallParams.IgnoreWater = true

local function hasLineOfSight(targetChar, targetPos)
    if not G.WallCheck then return true end
    local cam = workspace.CurrentCamera
    local myChar = LocalPlayer.Character
    if not cam or not myChar then return false end
    wallParams.FilterDescendantsInstances = {myChar, targetChar}
    local result = workspace:Raycast(cam.CFrame.Position, targetPos - cam.CFrame.Position, wallParams)
    return result == nil
end

