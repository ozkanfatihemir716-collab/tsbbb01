-- ==================== BACK TP / ANTI BLOCK ====================
local tpLockCF = nil
local tpLockUntil = 0
RunService.Heartbeat:Connect(function()
    if tpLockCF and tick() < tpLockUntil then
        local myChar = LocalPlayer.Character
        if myChar then
            local hrp = myChar:FindFirstChild("HumanoidRootPart")
            if hrp then
                pcall(function()
                    hrp.CFrame = tpLockCF
                    hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                    hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                end)
            end
        end
    elseif tpLockCF and tick() >= tpLockUntil then
        tpLockCF = nil
    end
end)

local function doBackTP(target, distance)
    distance = distance or 1.5
    if not target or not target.Character then return false end
    local tHrp = target.Character:FindFirstChild("HumanoidRootPart")
    if not tHrp then return false end
    local tHum = target.Character:FindFirstChildOfClass("Humanoid")
    if not tHum or tHum.Health <= 0 then return false end
    local myChar = LocalPlayer.Character
    if not myChar then return false end
    local myHrp = myChar:FindFirstChild("HumanoidRootPart")
    local myHum = myChar:FindFirstChildOfClass("Humanoid")
    if not myHrp or not myHum or myHum.Health <= 0 then return false end
    local tVel = tHrp.AssemblyLinearVelocity
    local backDir
    if tVel.Magnitude > 5 then
        local flatVel = Vector3.new(tVel.X, 0, tVel.Z)
        if flatVel.Magnitude > 0.1 then backDir = -flatVel.Unit
        else
            local look = tHrp.CFrame.LookVector
            backDir = -Vector3.new(look.X, 0, look.Z).Unit
        end
    else
        local look = tHrp.CFrame.LookVector
        backDir = -Vector3.new(look.X, 0, look.Z).Unit
    end
    local targetPos = tHrp.Position + backDir * distance
    local finalPos = Vector3.new(targetPos.X, tHrp.Position.Y + 0.5, targetPos.Z)
    local newCF = CFrame.lookAt(finalPos, tHrp.Position)
    pcall(function() myHum.PlatformStand = false end)
    pcall(function() myHum.Sit = false end)
    pcall(function()
        myHrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        myHrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
        myHrp.Velocity = Vector3.new(0, 0, 0)
        myHrp.RotVelocity = Vector3.new(0, 0, 0)
    end)
    local success = pcall(function() myChar:PivotTo(newCF) end)
    if not success then pcall(function() myHrp.CFrame = newCF end) end
    tpLockCF = newCF
    tpLockUntil = tick() + 0.3
    lastAnyTPTime = tick()
    return true
end

