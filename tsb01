local function zarzuraIsMoving()
    local myChar = LocalPlayer.Character
    if not myChar then return false end
    local hrp = myChar:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    if hrp.AssemblyLinearVelocity.Magnitude > 2 then return true end
    if UserInputService:IsKeyDown(Enum.KeyCode.W) then return true end
    if UserInputService:IsKeyDown(Enum.KeyCode.A) then return true end
    if UserInputService:IsKeyDown(Enum.KeyCode.S) then return true end
    if UserInputService:IsKeyDown(Enum.KeyCode.D) then return true end
    if UserInputService:IsKeyDown(Enum.KeyCode.Space) then return true end
    return false
end

local function zarzuraSuspend()
    if Zarzura.suspended then return end
    Zarzura.suspended = true
    Zarzura.suspendCount = Zarzura.suspendCount + 1
    Zarzura.savedStates = {}
    for k, v in pairs(G) do
        Zarzura.savedStates[k] = v
        G[k] = false
    end
    pcall(cleanAllESP)
    pcall(function()
        settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
        Lighting.GlobalShadows = false
        for _, obj in ipairs(Lighting:GetChildren()) do
            if obj:IsA("PostEffect") then obj.Enabled = false end
        end
    end)
    local myChar = LocalPlayer.Character
    if myChar then
        local hum = myChar:FindFirstChildOfClass("Humanoid")
        if hum then pcall(function() hum.WalkSpeed = 16 end) end
    end
end

local function zarzuraResume()
    if not Zarzura.suspended then return end
    Zarzura.suspended = false
    for k, v in pairs(Zarzura.savedStates) do G[k] = v end
    Zarzura.savedStates = {}
    if G.PerfBoost then applyPerfBoost() end
    if G.ESP then task.spawn(buildAllESPNow) end
end

local function zarzuraUpdate(dt)
    if zarzuraIsMoving() then
        Zarzura.idleTime = 0
        if Zarzura.suspended then zarzuraResume() end
    else
        Zarzura.idleTime = Zarzura.idleTime + dt
        if Zarzura.idleTime >= Zarzura.idleThreshold and not Zarzura.suspended then
            zarzuraSuspend()
        end
    end
end

-- ==================== SABRIS AI ====================
local Sabris = {
    enabled = true, lastCheck = 0, checkInterval = 1,
    cpuHistory = {}, cpuLoad = 0,
    errorLog = {}, backupCount = 0,
    featureHealth = {},
}

local function sabrisMeasureCPU()
    table.insert(Sabris.cpuHistory, fps)
    if #Sabris.cpuHistory > 8 then table.remove(Sabris.cpuHistory, 1) end
    local sum = 0
    for _, v in ipairs(Sabris.cpuHistory) do sum = sum + v end
    local avg = sum / math.max(1, #Sabris.cpuHistory)
    local variance = 0
    if #Sabris.cpuHistory > 1 then
        for _, v in ipairs(Sabris.cpuHistory) do variance = variance + (v - avg) ^ 2 end
        variance = variance / #Sabris.cpuHistory
    end
    Sabris.cpuLoad = math.clamp(100 - avg + math.sqrt(variance), 0, 100)
end

local function backup1_WalkSpeed()
    local char = LocalPlayer.Character
