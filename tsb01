    end)
end

local function sabrisCheckFeature(name, isHealthy, backupFn)
    if isHealthy then
        Sabris.featureHealth[name] = true
        return true
    end
    Sabris.featureHealth[name] = false
    if backupFn and backupFn() then
        Sabris.backupCount = Sabris.backupCount + 1
        Sabris.featureHealth[name] = true
        return true
    end
    return false
end

local function sabrisRunChecks()
    if Zarzura.suspended then return end
    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end

    if G.Speed then
        local healthy = math.abs(hum.WalkSpeed - Settings.WalkSpeed) < 0.5
        sabrisCheckFeature("WalkSpeed", healthy, backup1_WalkSpeed)
    end

    if G.Jump then
        local healthy = math.abs(hum.JumpPower - Settings.JumpPower) < 0.5 and hum.UseJumpPower
        sabrisCheckFeature("JumpPower", healthy, backup2_JumpPower)
    end

    if G.ESP then
        local missing = 0
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                local head = p.Character:FindFirstChild("Head")
                local h2 = p.Character:FindFirstChildOfClass("Humanoid")
                if head and h2 and h2.Health > 0 then
                    local d = espData[p]
                    if not d or not d.bb or not d.bb.Parent then missing = missing + 1 end
                end
            end
        end
        sabrisCheckFeature("ESP", missing == 0, backup3_ESP)
    end

    if G.Hitbox then
        local healthy = currentHitbox ~= nil and currentHitbox.Parent ~= nil
        sabrisCheckFeature("Hitbox", healthy, backup4_Hitbox)
    end

    if G.InfStamina then
        local healthy = true
        for _, name in ipairs({"Stamina","stamina","StaminaValue","Energy","energy"}) do
            local v = char:FindFirstChild(name, true)
            if v and (v:IsA("NumberValue") or v:IsA("IntValue")) then
                if v.Value < v.MaxValue - 1 then healthy = false; break end
            end
        end
        sabrisCheckFeature("InfStamina", healthy, backup5_InfStamina)
    end

    if G.NoRagdoll or G.FastGetUp then
        local state = hum:GetState()
        local healthy = state ~= Enum.HumanoidStateType.Ragdoll and state ~= Enum.HumanoidStateType.FallingDown
        sabrisCheckFeature("NoRagdoll", healthy, backup6_NoRagdoll)
    end
end

local function sabrisUpdate(dt)
    if not Sabris.enabled then return end
    Sabris.lastCheck = Sabris.lastCheck + dt
    pcall(sabrisMeasureCPU)
    if Sabris.lastCheck < Sabris.checkInterval then return end
    Sabris.lastCheck = 0
    pcall(sabrisRunChecks)
end

